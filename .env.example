# Copy this file to `.env` and adjust values for your local setup.
# All variables are optional — defaults match the repo layout.

# Root folder containing the `dataset_full.csv` + image subfolders.
BACTERIA_DATASET_ROOT=data/dataset

# Directory where trained artifacts (joblib + metrics json) are written.
BACTERIA_ARTIFACT_DIR=artifacts

# Full path (relative or absolute) to the trained model bundle.
# Defaults to {BACTERIA_ARTIFACT_DIR}/bacteria_models.joblib
#BACTERIA_MODEL_PATH=artifacts/bacteria_models.joblib
